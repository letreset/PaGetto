@* The Connect page of a Go feed: how to use it as a Go module proxy and upload modules to it. *@
@using Microsoft.Extensions.Options
@using PaGetto.Core.Authentication
@using PaGetto.Core.Configuration
@using PaGetto.Core.Feeds
@using PaGetto.Web.Extensions
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    var proxyUrl = Url.GoProxy();
    var host = new Uri(proxyUrl).Host;

    var authMode = AuthOptions.Value.Mode;
    var hasMirrors = FeedContext.CurrentFeed.Mirrors?.Any(m => m.Enabled) == true;
    var username = authMode == AuthenticationMode.Legacy ? "USERNAME" : FeedAuthenticationService.TokenUsername;
    var password = authMode == AuthenticationMode.Legacy ? "API_KEY" : "YOUR_TOKEN";

    // Without a mirror, public modules come from the public proxy: the go command tries the next
    // proxy of the list when this one answers 404.
    var goProxy = hasMirrors ? proxyUrl : $"{proxyUrl},https://proxy.golang.org,direct";

    var tabs = new[]
    {
        new
        {
            name = "Go",
            content = new[]
            {
                $"go env -w GOPROXY={goProxy}",
                "",
                "# Modules that are only in this feed are not in the public checksum database",
                "go env -w GONOSUMDB=example.com/*",
                "",
                "# The credentials: ~/.netrc (%USERPROFILE%\\_netrc on Windows)",
                $"machine {host}",
                $"login {username}",
                $"password {password}",
            },
            documentation = "https://go.dev/ref/mod#private-modules",
        },
        new
        {
            name = "go get",
            content = new[]
            {
                "go get example.com/my/module@v1.0.0",
                "",
                "# or, in go.mod",
                "require example.com/my/module v1.0.0",
            },
            documentation = "https://go.dev/ref/mod#go-get",
        },
        new
        {
            name = "Upload",
            content = new[]
            {
                "# The module zip: every file under example.com/my/module@v1.0.0/, with go.mod",
                "git archive --format=zip --prefix=example.com/my/module@v1.0.0/ -o module.zip v1.0.0",
                "",
                "# Uppercase letters of the path and version are written as ! and the lowercase letter",
                $"curl --fail-with-body -u {username}:{password} -T module.zip \\",
                $"  {proxyUrl}/example.com/my/module/@v/v1.0.0.zip",
            },
            documentation = "https://go.dev/ref/mod#zip-files",
        },
    };
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Connect</h1>
        <p class="bgt-lead">Use this feed as a Go module proxy.</p>
    </div>

    <div class="bgt-card bgt-card-body" style="padding: 16px">
        <div class="form-label" style="margin-bottom: 8px">GOPROXY URL · @FeedContext.CurrentFeed.Name</div>
        <div class="bgt-cmd bgt-cmd-value">
            <code id="feed-proxy-url">@proxyUrl</code>
            <button type="button" class="bgt-cmd-btn" title="Copy feed URL" data-copy-target="#feed-proxy-url">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
    </div>

    @if (authMode != AuthenticationMode.Legacy)
    {
        <div class="bgt-callout">
            <icon name="lock" size="18" />
            <div>
                <div class="bgt-callout-title">Authentication required</div>
                <div class="bgt-callout-body">
                    <p>The go command reads the credentials of the feed's host from your .netrc file: the login @FeedAuthenticationService.TokenUsername (or your username) and a personal access token (PAT) as the password. Use your token in place of YOUR_TOKEN below. Accounts without web sign-in get their token from an administrator.</p>
                    <p>The go command only sends credentials over HTTPS.</p>
                </div>
                <a asp-page="/Account/Tokens" class="d-inline-block mt-2 fw-medium">Create a personal access token &rarr;</a>
            </div>
        </div>
    }

    @if (!hasMirrors)
    {
        <div class="bgt-callout">
            <icon name="info" size="18" />
            <div>
                <div class="bgt-callout-title">This feed has no mirror</div>
                <div class="bgt-callout-body"><p>It only serves modules uploaded to it, so GOPROXY lists the public proxy after it. An administrator can add a mirror such as https://proxy.golang.org to get public modules through this feed.</p></div>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: tabs, active: tabs[0] }">
        <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Client">
            <template x-for="tab in tabs" :key="tab.name">
                <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: active.name === tab.name }"
                        x-bind:aria-selected="active.name === tab.name" x-text="tab.name" @@click="active = tab"></button>
            </template>
        </div>
        <div class="bgt-cmd">
            <code x-text="active.content.join('\n')"></code>
            <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
        <div class="bgt-card-foot">
            For more information, see the
            <a target="_blank" rel="noopener noreferrer" x-bind:href="active.documentation">documentation &#x2197;</a>
        </div>
    </div>
</div>

<script type="text/javascript">
    let tabs = @Json.Serialize(tabs);
</script>

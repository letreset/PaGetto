@* The Connect page of a RubyGems feed: how to install gems from it with Bundler and gem, and push gems to it. *@
@using Microsoft.Extensions.Options
@using PaGetto.Core.Authentication
@using PaGetto.Core.Configuration
@using PaGetto.Core.Feeds
@using PaGetto.Web.Extensions
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    var source = Url.RubyGemsSource();
    var pushHost = Url.RubyGemsHost();
    var sourceUri = new Uri(source);

    var authMode = AuthOptions.Value.Mode;
    var hasMirrors = FeedContext.CurrentFeed.Mirrors?.Any(m => m.Enabled) == true;
    var username = authMode == AuthenticationMode.Legacy ? "USERNAME" : FeedAuthenticationService.TokenUsername;
    var password = authMode == AuthenticationMode.Legacy ? "PASSWORD" : "YOUR_TOKEN";
    var apiKey = authMode == AuthenticationMode.Legacy ? "API_KEY" : "YOUR_TOKEN";

    // gem reads credentials from the source URL itself.
    var sourceWithCredentials = $"{sourceUri.Scheme}://{username}:{password}@{sourceUri.Authority}{sourceUri.PathAndQuery}";

    // Without a mirror, public gems come from rubygems.org, and only the gems of this feed from it.
    var gemfile = hasMirrors
        ? new[] { $"source \"{source}\"", "", "gem \"my_gem\"" }
        : new[] { "source \"https://rubygems.org\"", "", $"source \"{source}\" do", "  gem \"my_gem\"", "end" };

    var tabs = new[]
    {
        new
        {
            name = "Bundler",
            content = new[] { "# Gemfile" }
                .Concat(gemfile)
                .Concat(new[]
                {
                    "",
                    "# The credentials, once per machine",
                    $"bundle config set --global {sourceUri.Host} {username}:{password}",
                })
                .ToArray(),
            documentation = "https://bundler.io/man/bundle-config.1.html#CREDENTIALS-FOR-GEM-SOURCES",
        },
        new
        {
            name = "gem",
            content = new[]
            {
                $"gem sources --add {sourceWithCredentials}",
                "gem install my_gem",
                "",
                "# or for one install",
                $"gem install my_gem --source {sourceWithCredentials}",
            },
            documentation = "https://guides.rubygems.org/command-reference/#gem-install",
        },
        new
        {
            name = "Push",
            content = new[]
            {
                $"export GEM_HOST_API_KEY={apiKey}",
                "",
                "gem build my_gem.gemspec",
                $"gem push my_gem-1.0.0.gem --host {pushHost}",
                "",
                "# Yanking unlists the version",
                $"gem yank my_gem -v 1.0.0 --host {pushHost}",
            },
            documentation = "https://guides.rubygems.org/publishing/",
        },
    };
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Connect</h1>
        <p class="bgt-lead">Use this feed as a gem source for Bundler and RubyGems.</p>
    </div>

    <div class="bgt-card bgt-card-body" style="padding: 16px">
        <div class="form-label" style="margin-bottom: 8px">Gem source URL · @FeedContext.CurrentFeed.Name</div>
        <div class="bgt-cmd bgt-cmd-value">
            <code id="feed-gem-source">@source</code>
            <button type="button" class="bgt-cmd-btn" title="Copy feed URL" data-copy-target="#feed-gem-source">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
    </div>

    @if (authMode != AuthenticationMode.Legacy)
    {
        <div class="bgt-callout">
            <icon name="lock" size="18" />
            <div>
                <div class="bgt-callout-title">Authentication required</div>
                <div class="bgt-callout-body">
                    <p>Bundler and gem install send the username @FeedAuthenticationService.TokenUsername (or your username) and a personal access token (PAT) as the password. gem push and gem yank send the token alone, as the API key. Use your token in place of YOUR_TOKEN below. Accounts without web sign-in get their token from an administrator.</p>
                </div>
                <a asp-page="/Account/Tokens" class="d-inline-block mt-2 fw-medium">Create a personal access token &rarr;</a>
            </div>
        </div>
    }

    @if (!hasMirrors)
    {
        <div class="bgt-callout">
            <icon name="info" size="18" />
            <div>
                <div class="bgt-callout-title">This feed has no mirror</div>
                <div class="bgt-callout-body"><p>It only serves gems pushed to it, so the Gemfile gets public gems from rubygems.org and the gems of this feed from a source block. An administrator can add a mirror such as https://rubygems.org to get public gems through this feed.</p></div>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: tabs, active: tabs[0] }">
        <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Client">
            <template x-for="tab in tabs" :key="tab.name">
                <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: active.name === tab.name }"
                        x-bind:aria-selected="active.name === tab.name" x-text="tab.name" @@click="active = tab"></button>
            </template>
        </div>
        <div class="bgt-cmd">
            <code x-text="active.content.join('\n')"></code>
            <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
        <div class="bgt-card-foot">
            For more information, see the
            <a target="_blank" rel="noopener noreferrer" x-bind:href="active.documentation">documentation &#x2197;</a>
        </div>
    </div>
</div>

<script type="text/javascript">
    let tabs = @Json.Serialize(tabs);
</script>

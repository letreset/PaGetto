@using PaGetto.Core.Updates
@using PaGetto.Web.Helper
@model string
@inject ReleaseChecker ReleaseChecker
@inject ApplicationVersion RunningVersion
@* The model is the active tab: "Accounts", "Groups", "Feeds", "Vulnerabilities", "MaliciousPackages", "Quarantine" or "Audit". *@

<div class="bgt-admin-eyebrow">Administration</div>
<nav class="bgt-tabs bgt-admin-tabs" aria-label="Administration">
    <a asp-page="/Admin/Accounts" class="bgt-tab @(Model == "Accounts" ? "active" : null)" aria-current="@(Model == "Accounts" ? "page" : null)">Accounts</a>
    <a asp-page="/Admin/Groups" class="bgt-tab @(Model == "Groups" ? "active" : null)" aria-current="@(Model == "Groups" ? "page" : null)">Groups &amp; permissions</a>
    <a asp-page="/Admin/Feeds" class="bgt-tab @(Model == "Feeds" ? "active" : null)" aria-current="@(Model == "Feeds" ? "page" : null)">Feeds</a>
    <a asp-page="/Admin/Vulnerabilities" class="bgt-tab @(Model == "Vulnerabilities" ? "active" : null)" aria-current="@(Model == "Vulnerabilities" ? "page" : null)">Vulnerabilities</a>
    <a asp-page="/Admin/MaliciousPackages" class="bgt-tab @(Model == "MaliciousPackages" ? "active" : null)" aria-current="@(Model == "MaliciousPackages" ? "page" : null)">Malicious packages</a>
    <a asp-page="/Admin/Quarantine" class="bgt-tab @(Model == "Quarantine" ? "active" : null)" aria-current="@(Model == "Quarantine" ? "page" : null)">Quarantine</a>
    <a asp-page="/Admin/Audit" class="bgt-tab @(Model == "Audit" ? "active" : null)" aria-current="@(Model == "Audit" ? "page" : null)">Audit log</a>
</nav>

@{
    var newerRelease = ReleaseChecker.GetNewerRelease(RunningVersion.Version);
}
@if (newerRelease != null)
{
    <div class="alert alert-info mb-4" role="status">
        PaGetto <strong>@newerRelease.Version.ToNormalizedString()</strong> is available; this server runs @RunningVersion.Version.
        <a class="alert-link text-decoration-underline" href="@newerRelease.ReleaseNotesUrl" target="_blank" rel="noopener noreferrer">Release notes</a>
    </div>
}

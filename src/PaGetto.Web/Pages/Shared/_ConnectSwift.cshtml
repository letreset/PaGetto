@* The Connect page of a Swift feed: how to use it as a Swift package registry and publish to it. *@
@using Microsoft.Extensions.Options
@using PaGetto.Core.Authentication
@using PaGetto.Core.Configuration
@using PaGetto.Core.Feeds
@using PaGetto.Web.Extensions
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    var registryUrl = Url.SwiftRegistry();
    var isHttp = Context.Request.Scheme == "http";
    var insecure = isHttp ? " --allow-insecure-http" : "";

    var feed = FeedContext.CurrentFeed;
    var authMode = AuthOptions.Value.Mode;
    var token = authMode == AuthenticationMode.Legacy ? "API_KEY" : "YOUR_TOKEN";

    var tabs = new[]
    {
        new
        {
            name = "Set up",
            content = new[]
            {
                "# Use this feed for every package (without --global: this package only)",
                $"swift package-registry set --global{insecure} {registryUrl}",
                "",
                "# Sign in with a personal access token, kept in the keychain or ~/.netrc",
                $"swift package-registry login {registryUrl}/login --token {token}",
            },
            documentation = "https://docs.swift.org/swiftpm/documentation/packagemanagerdocs/usingswiftpackageregistry",
        },
        new
        {
            name = "Package.swift",
            content = new[]
            {
                "dependencies: [",
                "    .package(id: \"mona.LinkedList\", from: \"1.0.0\"),",
                "],",
                "targets: [",
                "    .target(name: \"MyApp\", dependencies: [",
                "        .product(name: \"LinkedList\", package: \"mona.LinkedList\"),",
                "    ]),",
                "]",
            },
            documentation = "https://docs.swift.org/swiftpm/documentation/packagemanagerdocs/usingswiftpackageregistry",
        },
        new
        {
            name = "Publish",
            content = new[]
            {
                "# In the package's folder; its package-metadata.json, if any, is published with it",
                $"swift package-registry publish mona.LinkedList 1.0.0 --url {registryUrl}{insecure}",
            },
            documentation = "https://docs.swift.org/swiftpm/documentation/packagemanagerdocs/packageregistrypublish",
        },
    };
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Connect</h1>
        <p class="bgt-lead">Use this feed as a Swift package registry, with Swift Package Manager or Xcode.</p>
    </div>

    <div class="bgt-card bgt-card-body" style="padding: 16px">
        <div class="form-label" style="margin-bottom: 8px">Registry URL · @feed.Name</div>
        <div class="bgt-cmd bgt-cmd-value">
            <code id="feed-registry-url">@registryUrl</code>
            <button type="button" class="bgt-cmd-btn" title="Copy feed URL" data-copy-target="#feed-registry-url">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
    </div>

    @if (authMode != AuthenticationMode.Legacy)
    {
        <div class="bgt-callout">
            <icon name="lock" size="18" />
            <div>
                <div class="bgt-callout-title">Authentication required</div>
                <div class="bgt-callout-body">
                    <p>Sign in once with swift package-registry login and a personal access token (PAT); Swift Package Manager and Xcode then send it with every request to this feed. Use your token in place of YOUR_TOKEN below. Accounts without web sign-in get their token from an administrator.</p>
                </div>
                <a asp-page="/Account/Tokens" class="d-inline-block mt-2 fw-medium">Create a personal access token &rarr;</a>
            </div>
        </div>
    }

    @if (isHttp)
    {
        <div class="bgt-callout">
            <icon name="info" size="18" />
            <div>
                <div class="bgt-callout-title">This server is not served over HTTPS</div>
                <div class="bgt-callout-body"><p>Swift Package Manager only uses registries over HTTPS. The commands below have --allow-insecure-http, but swift package-registry login has no such option and refuses this URL, so only a feed that needs no sign-in works this way. Serve the server over HTTPS for anything but local tests.</p></div>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: tabs, active: tabs[0] }">
        <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Client">
            <template x-for="tab in tabs" :key="tab.name">
                <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: active.name === tab.name }"
                        x-bind:aria-selected="active.name === tab.name" x-text="tab.name" @@click="active = tab"></button>
            </template>
        </div>
        <div class="bgt-cmd">
            <code x-text="active.content.join('\n')"></code>
            <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
        <div class="bgt-card-foot">
            For more information, see the
            <a target="_blank" rel="noopener noreferrer" x-bind:href="active.documentation">documentation &#x2197;</a>
        </div>
    </div>
</div>

<script type="text/javascript">
    let tabs = @Json.Serialize(tabs);
</script>

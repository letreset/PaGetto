@* The Connect page of a Cargo feed: how to use it as a Cargo registry. *@
@using Microsoft.Extensions.Options
@using PaGetto.Core.Configuration
@using PaGetto.Core.Feeds
@using PaGetto.Web.Extensions
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    var indexUrl = "sparse+" + Url.CargoIndex();

    // The feed's slug is a valid registry name, and Cargo reads its token from an environment
    // variable named after it.
    var registry = FeedContext.CurrentFeed.Slug;
    var tokenVariable = $"CARGO_REGISTRIES_{registry.ToUpperInvariant().Replace('-', '_')}_TOKEN";

    var authMode = AuthOptions.Value.Mode;
    var hasMirrors = FeedContext.CurrentFeed.Mirrors?.Any(m => m.Enabled) == true;
    var token = authMode == AuthenticationMode.Legacy ? "API_KEY" : "YOUR_TOKEN";

    var cargoConfig = new List<string>
    {
        "# .cargo/config.toml (in the project, or ~/.cargo/config.toml)",
        $"[registries.{registry}]",
        $"index = \"{indexUrl}\"",

        // Cargo only sends a token to a registry that asks for one on every request when a
        // credential provider is configured.
        "credential-provider = [\"cargo:token\"]",
    };

    if (hasMirrors)
    {
        cargoConfig.Add("");
        cargoConfig.Add("# Optional: get the crates of crates.io through this feed too");
        cargoConfig.Add("[source.crates-io]");
        cargoConfig.Add($"replace-with = \"{registry}\"");
    }

    cargoConfig.Add("");
    cargoConfig.Add("# The token: paste it when cargo login asks, or set it in the environment");
    cargoConfig.Add($"cargo login --registry {registry}");
    cargoConfig.Add($"{tokenVariable}={token}");

    var tabs = new[]
    {
        new
        {
            name = "Cargo",
            content = cargoConfig.ToArray(),
            documentation = "https://doc.rust-lang.org/cargo/reference/registries.html",
        },
        new
        {
            name = "Cargo.toml",
            content = new[]
            {
                "[dependencies]",
                $"my_crate = {{ version = \"1.0\", registry = \"{registry}\" }}",
                "",
                "# or",
                $"cargo add my_crate --registry {registry}",
            },
            documentation = "https://doc.rust-lang.org/cargo/reference/specifying-dependencies.html#specifying-dependencies-from-other-registries",
        },
        new
        {
            name = "Publish",
            content = new[]
            {
                "# Cargo.toml of the crate; keeps it from being published to crates.io",
                "[package]",
                $"publish = [\"{registry}\"]",
                "",
                $"cargo publish --registry {registry}",
                $"cargo yank --registry {registry} my_crate@1.0.0",
            },
            documentation = "https://doc.rust-lang.org/cargo/reference/publishing.html",
        },
    };
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Connect</h1>
        <p class="bgt-lead">Use this feed as a Cargo registry for Rust crates.</p>
    </div>

    <div class="bgt-card bgt-card-body" style="padding: 16px">
        <div class="form-label" style="margin-bottom: 8px">Index URL · @FeedContext.CurrentFeed.Name</div>
        <div class="bgt-cmd bgt-cmd-value">
            <code id="feed-index-url">@indexUrl</code>
            <button type="button" class="bgt-cmd-btn" title="Copy feed URL" data-copy-target="#feed-index-url">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
    </div>

    @if (authMode != AuthenticationMode.Legacy)
    {
        <div class="bgt-callout">
            <icon name="lock" size="18" />
            <div>
                <div class="bgt-callout-title">Authentication required</div>
                <div class="bgt-callout-body">
                    <p>Cargo sends a personal access token (PAT) with every request to this registry. Use your token in place of YOUR_TOKEN below. Accounts without web sign-in get their token from an administrator.</p>
                    <p>Keep the token out of version control: cargo login stores it in ~/.cargo/credentials.toml.</p>
                </div>
                <a asp-page="/Account/Tokens" class="d-inline-block mt-2 fw-medium">Create a personal access token &rarr;</a>
            </div>
        </div>
    }

    @if (!hasMirrors)
    {
        <div class="bgt-callout">
            <icon name="info" size="18" />
            <div>
                <div class="bgt-callout-title">This feed has no mirror</div>
                <div class="bgt-callout-body"><p>It only serves crates published to it. Dependencies from crates.io still come from crates.io; an administrator can add a mirror such as https://index.crates.io to get them through this feed.</p></div>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: tabs, active: tabs[0] }">
        <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Client">
            <template x-for="tab in tabs" :key="tab.name">
                <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: active.name === tab.name }"
                        x-bind:aria-selected="active.name === tab.name" x-text="tab.name" @@click="active = tab"></button>
            </template>
        </div>
        <div class="bgt-cmd">
            <code x-text="active.content.join('\n')"></code>
            <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
        <div class="bgt-card-foot">
            For more information, see the
            <a target="_blank" rel="noopener noreferrer" x-bind:href="active.documentation">documentation &#x2197;</a>
        </div>
    </div>
</div>

<script type="text/javascript">
    let tabs = @Json.Serialize(tabs);
</script>

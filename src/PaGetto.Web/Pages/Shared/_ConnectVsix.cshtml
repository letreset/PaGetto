@* The Connect page of a VSIX feed: how to add it to Visual Studio as an extension gallery and upload extensions to it. *@
@using Microsoft.Extensions.Options
@using PaGetto.Core.Authentication
@using PaGetto.Core.Configuration
@using PaGetto.Core.Feeds
@using PaGetto.Web.Extensions
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    var feed = FeedContext.CurrentFeed;
    var authMode = AuthOptions.Value.Mode;

    // Visual Studio only sends Windows credentials, so with user accounts it reads the gallery
    // through the URL with a personal access token in its path.
    var galleryUrl = authMode == AuthenticationMode.Legacy ? Url.VsixAtomFeed() : Url.VsixAtomFeedWithToken("YOUR_TOKEN");
    var uploadUrl = Url.VsixGallery() + "/upload";
    var username = authMode == AuthenticationMode.Legacy ? "USERNAME" : FeedAuthenticationService.TokenUsername;
    var password = authMode == AuthenticationMode.Legacy ? "API_KEY" : "YOUR_TOKEN";

    var tabs = new[]
    {
        new
        {
            name = "Upload",
            content = new[]
            {
                "# The VSIX file the VSIX project of the Visual Studio SDK builds",
                $"curl --fail-with-body -u {username}:{password} -T MyExtension.vsix \\",
                $"  {uploadUrl}",
            },
            documentation = "https://learn.microsoft.com/visualstudio/extensibility/shipping-visual-studio-extensions",
        },
        new
        {
            name = "PowerShell",
            content = new[]
            {
                $"$credentials = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes(\"{username}:{password}\"))",
                $"Invoke-RestMethod -Method Put -InFile .\\MyExtension.vsix -Uri {uploadUrl} `",
                "  -Headers @{ Authorization = \"Basic $credentials\" }",
            },
            documentation = "https://learn.microsoft.com/powershell/module/microsoft.powershell.utility/invoke-restmethod",
        },
        new
        {
            name = "VSIXInstaller",
            content = new[]
            {
                "# Installs a downloaded extension, e.g. in a script",
                "VSIXInstaller.exe /quiet MyExtension.vsix",
            },
            documentation = "https://learn.microsoft.com/visualstudio/extensibility/shipping-visual-studio-extensions#installing-and-uninstalling-extensions",
        },
    };
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Connect</h1>
        <p class="bgt-lead">Add this feed to Visual Studio as a private extension gallery.</p>
    </div>

    <div class="bgt-card bgt-card-body" style="padding: 16px">
        <div class="form-label" style="margin-bottom: 8px">Gallery URL · @feed.Name@(authMode == AuthenticationMode.Legacy ? null : " · replace YOUR_TOKEN with a personal access token")</div>
        <div class="bgt-cmd bgt-cmd-value">
            <code id="feed-gallery-url">@galleryUrl</code>
            <button type="button" class="bgt-cmd-btn" title="Copy feed URL" data-copy-target="#feed-gallery-url">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
    </div>

    <div class="bgt-callout">
        <icon name="info" size="18" />
        <div>
            <div class="bgt-callout-title">Add the gallery to Visual Studio</div>
            <div class="bgt-callout-body">
                <p>In Tools &gt; Options &gt; Environment &gt; Extensions, add an entry under Additional Extension Galleries with a name such as @feed.Name and the gallery URL above, then apply. Its extensions appear in Extensions &gt; Manage Extensions, and Visual Studio offers the updates of installed extensions that come from it.</p>
            </div>
        </div>
    </div>

    @if (authMode != AuthenticationMode.Legacy)
    {
        <div class="bgt-callout">
            <icon name="lock" size="18" />
            <div>
                <div class="bgt-callout-title">Authentication required</div>
                <div class="bgt-callout-body">
                    <p>Visual Studio can't sign in to an extension gallery: it only sends your Windows credentials. So the gallery URL above has a personal access token (PAT) in its path, which reads the gallery, its files and images, and nothing else. The token is stored in Visual Studio's settings and may appear in the logs of servers and proxies, so use the token of an account that can only pull from this feed, and give it an expiry.</p>
                    <p>Uploads send the username @FeedAuthenticationService.TokenUsername (or your username) and a token as the password. Accounts without web sign-in get their token from an administrator.</p>
                </div>
                <a asp-page="/Account/Tokens" class="d-inline-block mt-2 fw-medium">Create a personal access token &rarr;</a>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: tabs, active: tabs[0] }">
        <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Client">
            <template x-for="tab in tabs" :key="tab.name">
                <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: active.name === tab.name }"
                        x-bind:aria-selected="active.name === tab.name" x-text="tab.name" @@click="active = tab"></button>
            </template>
        </div>
        <div class="bgt-cmd">
            <code x-text="active.content.join('\n')"></code>
            <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
        <div class="bgt-card-foot">
            For more information, see the
            <a target="_blank" rel="noopener noreferrer" x-bind:href="active.documentation">documentation &#x2197;</a>
        </div>
    </div>
</div>

<script type="text/javascript">
    let tabs = @Json.Serialize(tabs);
</script>

@page
@model UploadModel
@using PaGetto.Core
@using PaGetto.Core.Configuration
@using PaGetto.Core.Feeds
@using Microsoft.Extensions.Options
@inject IUrlGenerator URL
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    ViewData["Title"] = "Upload · " + FeedContext.CurrentFeed.Name;

    var baseUrl = Url.PageLink("/Index");
    var publishUrl = URL.GetPackagePublishResourceUrl();
    var serviceIndexUrl = URL.GetServiceIndexUrl();

    var authMode = AuthOptions.Value.Mode;
    var hasEntra = authMode is AuthenticationMode.Entra or AuthenticationMode.Hybrid;
    var hasLocal = authMode is AuthenticationMode.Local or AuthenticationMode.Hybrid;
    var requiresAuth = authMode != AuthenticationMode.Config;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@if (requiresAuth && !isAuthenticated)
{
    // Generic on purpose: anonymous visitors must not learn feed or package names.
    ViewData["Title"] = "Sign in required";
    <div class="bgt-message">
        <h2>Sign in required</h2>
        <p>You need to sign in to view upload instructions.</p>
        <a asp-page="/Login" class="btn btn-primary">Sign in</a>
    </div>
    return;
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Upload</h1>
        <p class="bgt-lead">Upload a package from your browser, or push it with a client using the service index below.</p>
    </div>

    @if (Model.IsReadOnly)
    {
        <div class="bgt-callout">
            <icon name="info" size="18" />
            <div>
                <div class="bgt-callout-title">Read-only feed</div>
                <div class="bgt-callout-body"><p>@FeedContext.CurrentFeed.Name doesn't accept new packages.</p></div>
            </div>
        </div>
    }
    else
    {
        @Html.AntiForgeryToken()
        <div class="bgt-card bgt-upload" id="browser-upload"
             data-check-url="@Url.Page("/Upload", "Check")"
             data-package-url="@Url.Page("/Upload", "Package")"
             data-symbol-url="@Url.Page("/Upload", "Symbol")"
             data-max-bytes="@((Model.MaxPackageSizeGiB * 1024L * 1024 * 1024).ToString(System.Globalization.CultureInfo.InvariantCulture))"
             data-max-gib="@Model.MaxPackageSizeGiB.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-api-key-required="@(Model.ApiKeyRequired ? "true" : "false")"
             x-data="pagettoUploader($el)">
            <h2 class="bgt-card-head m-0">Upload from browser</h2>
            <div class="bgt-card-body bgt-stack">
                <label class="bgt-drop" x-bind:class="{ 'bgt-drop-active': dragging }"
                       @@dragover.prevent="dragging = true" @@dragleave.prevent="dragging = false" @@drop.prevent="drop($event)">
                    <input type="file" class="visually-hidden" accept=".nupkg,.snupkg" multiple @@change="pick($event)" />
                    <icon name="arrow-up" size="20" />
                    <span>Drop .nupkg or .snupkg files here, or <span class="bgt-drop-link">browse</span></span>
                    <span class="bgt-drop-hint">Up to @Model.MaxPackageSizeGiB.ToString(System.Globalization.CultureInfo.InvariantCulture) GiB per file</span>
                </label>

                @if (Model.ApiKeyRequired)
                {
                    <div>
                        <label class="form-label" for="upload-api-key">API key</label>
                        <input id="upload-api-key" type="password" class="form-control" autocomplete="off" x-model="apiKey" />
                    </div>
                }

                <template x-for="item in items" :key="item.key">
                    <div class="bgt-upload-item">
                        <div class="bgt-upload-item-head">
                            <div class="bgt-upload-item-title">
                                <template x-if="item.metadata">
                                    <span><strong x-text="item.metadata.id"></strong> <span class="bgt-version" x-text="item.metadata.version"></span></span>
                                </template>
                                <template x-if="!item.metadata"><strong x-text="item.name"></strong></template>
                                <span class="bgt-pill" x-show="item.kind === 'symbol'">Symbols</span>
                            </div>
                            <button type="button" class="bgt-upload-remove" title="Remove" aria-label="Remove" x-show="item.state !== 'uploading'" @@click="remove(item)">
                                <icon name="x" size="13" />
                            </button>
                        </div>
                        <div class="bgt-upload-file" x-text="item.name + ' · ' + item.size"></div>

                        <template x-if="item.metadata && item.state !== 'published'">
                            <dl class="bgt-upload-meta">
                                <template x-if="item.metadata.authors"><div><dt>Authors</dt><dd x-text="item.metadata.authors"></dd></div></template>
                                <template x-if="item.metadata.license"><div><dt>License</dt><dd x-text="item.metadata.license"></dd></div></template>
                                <template x-if="item.metadata.description"><div><dt>Description</dt><dd class="bgt-upload-clamp" x-text="item.metadata.description"></dd></div></template>
                                <template x-if="item.metadata.dependencyGroups.length > 0">
                                    <div>
                                        <dt>Dependencies</dt>
                                        <dd>
                                            <template x-for="group in item.metadata.dependencyGroups" :key="group.framework">
                                                <div class="bgt-upload-deps">
                                                    <span class="bgt-fw" x-text="group.framework"></span>
                                                    <span x-text="group.items.length === 0 ? 'No dependencies' : group.items.map(d => d.id + (d.range ? ' ' + d.range : '')).join(', ')"></span>
                                                </div>
                                            </template>
                                        </dd>
                                    </div>
                                </template>
                            </dl>
                        </template>

                        <div class="bgt-bar bgt-upload-progress" x-show="item.state === 'uploading'">
                            <div x-bind:style="'width: ' + item.progress + '%'"></div>
                        </div>
                        <div class="bgt-upload-note" x-show="item.note" x-bind:class="'bgt-upload-note-' + item.noteLevel">
                            <span x-text="item.note"></span>
                            <template x-if="item.url"><a x-bind:href="item.url">View package</a></template>
                        </div>
                    </div>
                </template>

                <div class="bgt-form-actions" x-show="items.length > 0">
                    <button type="button" class="btn btn-primary" x-bind:disabled="!canUpload" @@click="upload()">
                        <span x-text="busy ? 'Uploading…' : 'Upload'"></span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" x-show="hasFinished && !busy" @@click="clearFinished()">Clear finished</button>
                </div>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-body" style="padding: 16px">
        <div class="form-label" style="margin-bottom: 8px">Service index · @FeedContext.CurrentFeed.Name</div>
        <div class="bgt-cmd bgt-cmd-value">
            <code id="feed-service-index-url">@serviceIndexUrl</code>
            <button type="button" class="bgt-cmd-btn" title="Copy feed URL" data-copy-target="#feed-service-index-url">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
    </div>

    @if (hasEntra || hasLocal)
    {
        <div class="bgt-callout">
            <icon name="lock" size="18" />
            <div>
                <div class="bgt-callout-title">Authentication required</div>
                <div class="bgt-callout-body">
                    @if (hasEntra && hasLocal)
                    {
                        <p>Entra (Microsoft) users: sign in to the web UI to generate a personal access token (PAT), then use it as the API key.</p>
                        <p>Local accounts: use your username and password with basic authentication.</p>
                    }
                    else if (hasEntra)
                    {
                        <p>Sign in with your Microsoft account to generate a personal access token (PAT), then use it as the API key when pushing packages.</p>
                    }
                    else
                    {
                        <p>Use your local account username and password with basic authentication when pushing packages.</p>
                    }
                </div>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: tabs, active: tabs[0] }">
        <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Client">
            <template x-for="tab in tabs" :key="tab.name">
                <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: active.name === tab.name }"
                        x-bind:aria-selected="active.name === tab.name" x-text="tab.name" @@click="active = tab"></button>
            </template>
        </div>
        <div class="bgt-cmd">
            <code x-text="active.content.join('\n')"></code>
            <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
        <div class="bgt-card-foot">
            For more information, see the
            <a target="_blank" rel="noopener noreferrer" x-bind:href="active.documentation" x-text="`${active.name} documentation ↗`"></a>
        </div>
    </div>
</div>

<script type="text/javascript">
    let tabs = [
        {
            name: ".NET CLI",
            content: ["dotnet nuget push -s @serviceIndexUrl -k YOUR_API_KEY package.nupkg"],
            documentation: "https://docs.microsoft.com/en-us/dotnet/core/tools/dotnet-nuget-push",
        },

        {
            name: "NuGet",
            content: ["nuget push -Source @serviceIndexUrl -ApiKey YOUR_API_KEY package.nupkg"],
            documentation: "https://docs.microsoft.com/en-us/nuget/tools/cli-ref-push",
        },

        {
            name: "Paket",
            content: ["paket push --url @baseUrl package.nupkg"],
            documentation: "https://fsprojects.github.io/Paket/paket-push.html",
        },

        // TODO: This is broken...
        {
            name: "PowerShellGet",
            content: [
                "Register-PSRepository -Name \"PaGetto\" -SourceLocation \"@serviceIndexUrl\" "
                  + "-PublishLocation \"@publishUrl\" -InstallationPolicy \"Trusted\"",
                "Publish-Module -Name PS-Module -Repository PaGetto"
            ],
            documentation: "https://docs.microsoft.com/en-us/powershell/module/powershellget/publish-module",
        },
    ];
</script>

@section Scripts {
    <script src="~/_content/PaGetto.Web/js/upload.js" asp-append-version="true"></script>
}

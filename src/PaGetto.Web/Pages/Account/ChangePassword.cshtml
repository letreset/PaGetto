@page
@model PaGetto.Web.Pages.Account.ChangePasswordModel

@{
    ViewData["Title"] = "Change password";
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Change password</h1>
        <p class="bgt-lead">Your local account password for the web UI and NuGet clients.</p>
    </div>

    @if (Model.IsRequired)
    {
        <div class="alert alert-warning mb-0" role="alert">
            You are using a default or temporary password. Choose a new password to continue.
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success mb-0" role="alert">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger mb-0" role="alert">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.IsLocalAccount)
    {
        <div class="bgt-card bgt-card-body">
            <form method="post" class="bgt-stack">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div>
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" minlength="@PaGetto.Core.Authentication.PasswordPolicy.MinPasswordLength" />
                    <div class="form-text">At least @PaGetto.Core.Authentication.PasswordPolicy.MinPasswordLength characters.</div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary">Change password</button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-info mb-0" role="alert">
            Your account signs in with Microsoft Entra ID, so its password is managed there.
        </div>
    }
</div>

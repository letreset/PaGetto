@page "/artifacts/{id}/{version?}"
@using System.Globalization
@using Humanizer
@using Microsoft.Extensions.Options
@using PaGetto.Core.CocoaPods
@using PaGetto.Core.Configuration
@using PaGetto.Core.Cran
@using PaGetto.Core.Entities
@using PaGetto.Core.Feeds
@using PaGetto.Core.Go
@using PaGetto.Core.Hex
@using PaGetto.Core.Ivy
@using PaGetto.Core.Maven
@using PaGetto.Core.PyPI
@using PaGetto.Core.RubyGems
@using PaGetto.Core.Swift
@using PaGetto.Core.VsCode
@using PaGetto.Core.Vsix
@using PaGetto.Web.Extensions
@using PaGetto.Web.Helper
@model ArtifactModel
@inject IOptions<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    ViewData["Title"] = Model.Found ? Model.Name + " " + Model.Version.Version : Model.Name;
    var requiresAuth = AuthOptions.Value.Mode != AuthenticationMode.Legacy;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@if (requiresAuth && !isAuthenticated)
{
    // Generic on purpose: anonymous visitors must not learn feed or package names.
    ViewData["Title"] = "Sign in required";
    <div class="bgt-message">
        <h2>Sign in required</h2>
        <p>You need to sign in to view package details.</p>
        <a asp-page="/Login" class="btn btn-primary">Sign in</a>
    </div>
    return;
}

@if (Model.VersionNotFound != null)
{
    <div class="bgt-message">
        <h2>Version not found</h2>
        <p>Package '@Model.Name' has no version '@Model.VersionNotFound' in this feed.</p>
        <a asp-page="Artifact" asp-route-id="@Model.Id" asp-route-version="" class="btn btn-secondary">Show the latest version</a>
    </div>
    return;
}

@if (!Model.Found)
{
    <div class="bgt-message">
        <h2>Oops, package not found...</h2>
        <p>Could not find package '@Model.Name' in this feed.</p>
        <p>Packages that are only available from a mirror are listed here after their first download.</p>
    </div>
    return;
}

@{
    var feed = FeedContext.CurrentFeed;
    var name = Model.Name;
    var current = Model.Version;
    var version = current.Version;
    var feedUrl = Url.PageLink("/Index").TrimEnd('/');
    var maxDownloads = Math.Max(1, Model.Versions.Max(v => v.Downloads));
    var hasPrerelease = Model.Versions.Any(v => v.IsPrerelease);

    // Dart calls an unlisted version "retracted", npm "deprecated", Python, Cargo and RubyGems "yanked", Hex "retired".
    var isPub = feed.Type == FeedType.Pub;
    var isNpm = feed.Type == FeedType.Npm;
    var isMaven = feed.Type == FeedType.Maven;
    var isIvy = feed.Type == FeedType.Ivy;
    var isPyPI = feed.Type == FeedType.PyPI;
    var isCargo = feed.Type == FeedType.Cargo;
    var isGo = feed.Type == FeedType.Go;
    var isRubyGems = feed.Type == FeedType.RubyGems;
    var isHex = feed.Type == FeedType.Hex;
    var isComposer = feed.Type == FeedType.Composer;
    var isCocoaPods = feed.Type == FeedType.CocoaPods;
    var isSwift = feed.Type == FeedType.Swift;
    var isCran = feed.Type == FeedType.Cran;
    var isVsix = feed.Type == FeedType.Vsix;
    var isVsCode = feed.Type == FeedType.VsCode;
    var isYanked = isPyPI || isCargo || isRubyGems;

    // A Maven package is named groupId:artifactId.
    var groupId = isMaven ? name[..name.IndexOf(':')] : null;
    var artifactId = isMaven ? name[(name.IndexOf(':') + 1)..] : null;
    var unlistedLabel = isPub ? "retracted" : isNpm ? "deprecated" : isYanked ? "yanked" : isHex ? "retired" : "unlisted";
    var unlistVerb = isPub ? "Retract" : isNpm ? "Deprecate" : isYanked ? "Yank" : isHex ? "Retire" : "Unlist";
    var unlistGerund = isPub ? "Retracting" : isNpm ? "Deprecating" : isYanked ? "Yanking" : isHex ? "Retiring" : "Unlisting";
    var relistVerb = isPub ? "Restore" : isNpm ? "Undeprecate" : isYanked ? "Unyank" : isHex ? "Unretire" : "Relist";

    // A Python project's files are at its normalized name.
    var pypiName = isPyPI ? PyPIPackageName.Normalize(name) : null;

    // A Visual Studio extension is shown by its display name; its files are named by its identifier.
    var vsixId = isVsix ? Model.VsixManifest.Id ?? Model.Id : null;

    // A VS Code extension is shown by its display name too; it is installed by its identifier, publisher.name.
    var vsCode = isVsCode ? Model.VsCodeManifest.Main : null;
    var vsCodeId = vsCode?.Id ?? (isVsCode ? Model.Id : null);

    // A Swift package identifier is scope.name.
    var swiftScope = isSwift ? name[..name.IndexOf('.')] : null;
    var swiftName = isSwift ? name[(name.IndexOf('.') + 1)..] : null;

    // The parts of the manifest the page shows, from the ecosystem's own summary.
    var environment = Model.Pubspec?.Environment ?? Model.NpmManifest?.Engines
        ?? (Model.PyPIManifest?.RequiresPython is { } requiresPython ? [KeyValuePair.Create("Python", requiresPython)]
            : Model.CargoManifest?.RustVersion is { } rustVersion ? [KeyValuePair.Create("Rust", rustVersion)]
            : Model.GoMod?.GoVersion is { } goVersion ? [KeyValuePair.Create("Go", goVersion)]
            : Model.RubyGemsManifest?.RequiredRubyVersion is { } rubyVersion ? [KeyValuePair.Create("Ruby", rubyVersion)]
            : Model.HexManifest?.Elixir is { } elixirVersion ? [KeyValuePair.Create("Elixir", elixirVersion)]
            : Model.ComposerManifest?.Php is { } phpVersion ? [KeyValuePair.Create("PHP", phpVersion)]
            : Model.CocoaPodsManifest?.Platforms
            ?? (Model.SwiftManifest?.ToolsVersion is { } toolsVersion ? [KeyValuePair.Create("Swift tools", toolsVersion)]
            : Model.CranManifest?.RVersion is { } rVersion ? [KeyValuePair.Create("R", rVersion)] : IvyEnvironment(Model.IvyManifest) ?? VsixEnvironment(Model.VsixManifest) ?? VsCodeEnvironment(vsCode)));
    var dependencies = Model.Pubspec?.Dependencies ?? Model.NpmManifest?.Dependencies ?? Model.MavenPom?.Dependencies ?? Model.PyPIManifest?.Dependencies
        ?? Model.CargoManifest?.Dependencies
        ?? Model.GoMod?.Requires.Where(r => !r.Indirect).Select(r => KeyValuePair.Create(r.Path, r.Version)).ToList()
        ?? Model.RubyGemsManifest?.Dependencies
        ?? Model.HexManifest?.Requirements.Select(r => KeyValuePair.Create(r.Name, r.Requirement)).ToList()
        ?? Model.ComposerManifest?.Dependencies
        ?? Model.CocoaPodsManifest?.Dependencies
        ?? Model.CranManifest?.Dependencies
        ?? Model.IvyManifest?.Dependencies
        ?? Model.VsixManifest?.Dependencies.Select(d => KeyValuePair.Create(d.Id, d.Version ?? "")).ToList()
        ?? VsCodeDependencies(vsCode);
    var links = Model.Pubspec?.Links ?? Model.NpmManifest?.Links ?? Model.MavenPom?.Links ?? Model.PyPIManifest?.Links ?? Model.CargoManifest?.Links
        ?? Model.RubyGemsManifest?.Links ?? Model.HexManifest?.Links ?? Model.ComposerManifest?.Links
        ?? Model.CocoaPodsManifest?.Links ?? Model.SwiftManifest?.Links ?? Model.CranManifest?.Links
        ?? Model.IvyManifest?.Links ?? VsixLinks(Model.VsixManifest) ?? VsCodeLinks(vsCode);
    var license = Model.NpmManifest?.License ?? Model.MavenPom?.License ?? Model.PyPIManifest?.License ?? Model.CargoManifest?.License
        ?? Model.RubyGemsManifest?.License
        ?? (Model.HexManifest?.Licenses.Count > 0 ? string.Join(", ", Model.HexManifest.Licenses) : null)
        ?? Model.ComposerManifest?.License
        ?? Model.CocoaPodsManifest?.License
        ?? Model.CranManifest?.License
        ?? Model.IvyManifest?.License;
    var topics = Model.Pubspec?.Topics ?? Model.NpmManifest?.Keywords ?? Model.PyPIManifest?.Keywords ?? Model.CargoManifest?.Keywords
        ?? Model.ComposerManifest?.Keywords ?? Model.VsixManifest?.Tags
        ?? vsCode?.Tags.Where(t => !t.StartsWith("__", StringComparison.Ordinal)).ToList();

    string DownloadUrl(string rowVersion) => isPub
        ? Url.RouteUrl(Routes.PubArchiveRouteName, new { name, version = rowVersion })
        : isNpm ? Url.NpmTarball(name, rowVersion)
        : isCargo ? $"{Url.CargoDownloads()}/{Uri.EscapeDataString(name)}/{Uri.EscapeDataString(rowVersion)}/download"
        : isGo ? Url.GoZip(name, rowVersion)
        : isHex ? $"{Url.HexRepository()}/tarballs/{name}-{Uri.EscapeDataString(rowVersion)}.tar"
        : isComposer ? Url.ComposerDist(name, rowVersion, null)
        : isCocoaPods ? PodSourceUrl(Model.Versions.First(v => v.Version == rowVersion))
        : isSwift ? Url.SwiftArchive(swiftScope, swiftName, rowVersion)
        : isCran ? Url.CranPackage(name, rowVersion)
        : isVsix ? Url.VsixDownload(vsixId, rowVersion)
        : isVsCode ? VsCodeDownloadUrl(Model.Versions.First(v => v.Version == rowVersion)) : null;

    // A version's source archive, when it was published with one.
    string PodSourceUrl(ArtifactVersion row) => row.ContentHash != null && CocoaPodsPodspec.GetStoredArchiveType(row.MetadataJson) is { } archiveType
        ? Url.CocoaPodsSource(name, row.Version, archiveType)
        : null;

    // The VSIX file of a version: the universal one, or else the first platform's.
    string VsCodeDownloadUrl(ArtifactVersion row) => VsCodeVersionManifest.Parse(row.MetadataJson).Main is { } file
        ? $"{Url.VsCodeGallery()}/asset/{Uri.EscapeDataString(file.Publisher)}/{Uri.EscapeDataString(file.Name)}/{Uri.EscapeDataString(row.Version)}/{VsCodeGalleryApi.VsixPackageAsset}"
            + (file.TargetPlatform == VsCodeTargetPlatform.Universal ? "" : $"?targetPlatform={file.TargetPlatform}")
        : null;

    var downloadUrl = DownloadUrl(version);

    var installTabs = new List<InstallTab>();
    if (isPub)
    {
        installTabs.Add(new InstallTab
        {
            Name = "pubspec.yaml",
            Content = ["dependencies:", $"  {name}:", $"    hosted: {feedUrl}", $"    version: ^{version}"],
        });
        installTabs.Add(new InstallTab { Name = "Dart", Content = [$"dart pub add {name}:^{version} --hosted-url {feedUrl}"] });
        installTabs.Add(new InstallTab { Name = "Flutter", Content = [$"flutter pub add {name}:^{version} --hosted-url {feedUrl}"] });
    }
    else if (isNpm)
    {
        installTabs.Add(new InstallTab { Name = "npm", Content = [$"npm install {name}@{version}"] });
        installTabs.Add(new InstallTab { Name = "Yarn", Content = [$"yarn add {name}@{version}"] });
        installTabs.Add(new InstallTab { Name = "pnpm", Content = [$"pnpm add {name}@{version}"] });
        installTabs.Add(new InstallTab { Name = "package.json", Content = ["\"dependencies\": {", $"  \"{name}\": \"^{version}\"", "}"] });
    }
    else if (isMaven)
    {
        installTabs.Add(new InstallTab { Name = "Maven", Content = MavenDependency(groupId, artifactId, version) });
        installTabs.Add(new InstallTab { Name = "Gradle (Kotlin)", Content = [$"implementation(\"{groupId}:{artifactId}:{version}\")"] });
        installTabs.Add(new InstallTab { Name = "Gradle (Groovy)", Content = [$"implementation '{groupId}:{artifactId}:{version}'"] });
        installTabs.Add(new InstallTab { Name = "sbt", Content = [$"libraryDependencies += \"{groupId}\" % \"{artifactId}\" % \"{version}\""] });
    }
    else if (isIvy)
    {
        // An sbt plugin is added in project/plugins.sbt, a library in build.sbt; both need the resolver.
        var ivy = Model.IvyManifest;
        var resolver = $"resolvers += Resolver.url(\"{feed.Slug}\", url(\"{feedUrl}/ivy\"))(Resolver.ivyStylePatterns)";
        var dependency = $"\"{ivy.Organisation}\" % \"{ivy.Module}\" % \"{version}\"";
        installTabs.Add(ivy.IsSbtPlugin
            ? new InstallTab { Name = "sbt plugin", Content = ["// project/plugins.sbt", resolver, $"addSbtPlugin({dependency})"] }
            : new InstallTab { Name = "sbt", Content = ["// build.sbt", resolver, $"libraryDependencies += {dependency}"] });
    }
    else if (isPyPI)
    {
        installTabs.Add(new InstallTab { Name = "pip", Content = [$"pip install {name}=={version}"] });
        installTabs.Add(new InstallTab { Name = "uv", Content = [$"uv add {name}=={version}"] });
        installTabs.Add(new InstallTab { Name = "Poetry", Content = [$"poetry add {name}=={version}"] });
        installTabs.Add(new InstallTab { Name = "requirements.txt", Content = [$"{name}=={version}"] });
    }
    else if (isCargo)
    {
        // The feed's slug is the registry name its Connect page configures.
        installTabs.Add(new InstallTab { Name = "Cargo", Content = [$"cargo add {name}@{version} --registry {feed.Slug}"] });
        installTabs.Add(new InstallTab { Name = "Cargo.toml", Content = ["[dependencies]", $"{name} = {{ version = \"{version}\", registry = \"{feed.Slug}\" }}"] });
    }
    else if (isGo)
    {
        installTabs.Add(new InstallTab { Name = "go get", Content = [$"go get {name}@{version}"] });
        installTabs.Add(new InstallTab { Name = "go.mod", Content = [$"require {name} {version}"] });
    }
    else if (isRubyGems)
    {
        var gemSource = Url.RubyGemsSource();
        installTabs.Add(new InstallTab { Name = "Bundler", Content = [$"bundle add {name} --version \"{version}\" --source \"{gemSource}\""] });
        installTabs.Add(new InstallTab { Name = "Gemfile", Content = [$"source \"{gemSource}\" do", $"  gem \"{name}\", \"{version}\"", "end"] });
        installTabs.Add(new InstallTab { Name = "gem install", Content = [$"gem install {name} -v {version} --source {gemSource}"] });
    }
    else if (isHex)
    {
        // The feed's slug is the repository name its Connect page configures.
        installTabs.Add(new InstallTab { Name = "Mix", Content = [$"{{:{name}, \"~> {version}\", repo: \"{feed.Slug}\"}}"] });
        installTabs.Add(new InstallTab { Name = "rebar.config", Content = [$"{{deps, [{{{name}, \"{version}\"}}]}}."] });
    }
    else if (isComposer)
    {
        installTabs.Add(new InstallTab { Name = "Composer", Content = [$"composer require {name}:{version}"] });
        installTabs.Add(new InstallTab { Name = "composer.json", Content = ["\"require\": {", $"  \"{name}\": \"{version}\"", "}"] });
    }
    else if (isCocoaPods)
    {
        installTabs.Add(new InstallTab { Name = "Podfile", Content = [$"source '{Url.CocoaPodsRepository()}'", "", $"pod '{name}', '{version}'"] });
    }
    else if (isSwift)
    {
        installTabs.Add(new InstallTab { Name = "Package.swift", Content = ["dependencies: [", $"    .package(id: \"{name}\", from: \"{version}\"),", "]"] });
        installTabs.Add(new InstallTab { Name = "Registry", Content = [$"swift package-registry set {Url.SwiftRegistry()}"] });
    }
    else if (isCran)
    {
        // install.packages installs the current version; renv installs a given one.
        var repository = Url.CranRepository();
        installTabs.Add(new InstallTab { Name = "R", Content = [$"install.packages(\"{name}\", repos = \"{repository}\")"] });
        installTabs.Add(new InstallTab { Name = "renv", Content = [$"renv::install(\"{name}@{version}\", repos = \"{repository}\")"] });
    }
    else if (isVsix)
    {
        // Visual Studio adds the gallery under Tools > Options > Environment > Extensions; it can't send
        // credentials, so with user accounts the gallery URL has a token. A downloaded file installs with VSIXInstaller.
        installTabs.Add(new InstallTab { Name = "Gallery", Content = [requiresAuth ? Url.VsixAtomFeedWithToken("YOUR_TOKEN") : Url.VsixAtomFeed()] });
        installTabs.Add(new InstallTab { Name = "VSIXInstaller", Content = [$"VSIXInstaller.exe {VsixGalleryPaths.GetFileName(vsixId, version)}"] });
    }
    else if (isVsCode)
    {
        // An editor pointed at the gallery (see Connect) installs by identifier; a downloaded file installs anywhere.
        installTabs.Add(new InstallTab { Name = "CLI", Content = [$"code --install-extension {vsCodeId}@{version}"] });
        installTabs.Add(new InstallTab { Name = "VSIX", Content = [$"code --install-extension {VsCodeManifest.GetFileName(vsCodeId, version, vsCode?.TargetPlatform ?? VsCodeTargetPlatform.Universal)}"] });
    }
}

<nav class="bgt-breadcrumb" aria-label="Breadcrumb">
    <a asp-page="/Index">@feed.Name</a><span aria-hidden="true">/</span><span class="current">@name</span>
</nav>

<div class="bgt-detail">
    <div class="bgt-detail-main">
        <div class="bgt-detail-head">
            <div class="bgt-tile bgt-tile-lg" style="--h: @name.ToHue()" aria-hidden="true">@name.ToPackageInitials()</div>
            <div style="min-width: 0">
                <div class="bgt-detail-title">
                    <h1>@name</h1>
                    <span class="bgt-detail-version">
                        @version
                        @if (Model.IsLatest)
                        {
                            <span class="bgt-badge bgt-badge-ok">latest</span>
                        }
                        @if (!current.Listed)
                        {
                            <span class="bgt-badge bgt-badge-warn">@unlistedLabel</span>
                        }
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(current.Description))
                {
                    <p class="bgt-detail-desc">@current.Description</p>
                }

                @if (environment?.Count > 0)
                {
                    <div class="bgt-chips">
                        @foreach (var constraint in environment)
                        {
                            <span class="bgt-fw" title="The @constraint.Key versions this package supports.">@constraint.Key @constraint.Value</span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (current.IsPrerelease || !current.Listed)
        {
            <ul class="bgt-notes">
                @if (current.IsPrerelease)
                {
                    <li><icon name="info" size="15" />This is a prerelease version of @name.</li>
                }
                @if (!current.Listed && isNpm)
                {
                    <li><icon name="info" size="15" />This version is deprecated: @(string.IsNullOrEmpty(Model.NpmManifest.Deprecated) ? "no reason given" : Model.NpmManifest.Deprecated). Clients warn when they install it.</li>
                }
                else if (!current.Listed)
                {
                    <li><icon name="info" size="15" />This version is @unlistedLabel. Clients don't select it for new installs.</li>
                }
            </ul>
        }

        <partial name="_Vulnerabilities" model="Model.Vulnerabilities" />

        <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: installTabs, active: installTabs[0] }">
            <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Install command">
                <template x-for="tab in tabs" :key="tab.name">
                    <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: tab.name === active.name }"
                            x-bind:aria-selected="tab.name === active.name" x-text="tab.name" @@click="active = tab"></button>
                </template>
            </div>
            <div class="bgt-cmd">
                <code x-text="active.content.join('\n')"></code>
                <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                    <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
                </button>
            </div>
        </div>

        <div class="bgt-card bgt-card-clip" x-data="{ tab: 'readme' }">
            <div class="bgt-tabs" role="tablist" aria-label="Package details">
                @{ await TabButton("readme", "Readme", null); }
                @if (dependencies != null)
                {
                    await TabButton("dependencies", "Dependencies", dependencies.Count);
                }
                @if (isMaven || isIvy || isPyPI || isRubyGems)
                {
                    await TabButton("files", "Files", Model.Files.Count);
                }
                @{ await TabButton("versions", "Versions", Model.Versions.Count); }
            </div>

            <div class="bgt-tab-body" x-show="tab === 'readme'" role="tabpanel">
                @if (Model.Readme == null)
                {
                    <div class="bgt-markdown bgt-plain">@current.Description</div>
                }
                else
                {
                    <div class="bgt-markdown">@Model.Readme</div>
                }
            </div>

            @if (dependencies != null)
            {
                <div class="bgt-tab-body" x-show="tab === 'dependencies'" x-cloak role="tabpanel">
                    @if (dependencies.Count == 0)
                    {
                        <p class="text-muted mb-0">This package has no dependencies.</p>
                    }
                    else
                    {
                        <div class="bgt-dep-group">
                            @foreach (var dependency in dependencies)
                            {
                                <div class="bgt-dep">
                                    <a asp-page="Artifact" asp-route-id="@(isGo ? GoModulePath.Escape(dependency.Key) : isCocoaPods ? CocoaPodsPodName.Escape(dependency.Key.Split('/')[0]) : isCran ? CranPackageName.Normalize(dependency.Key) : dependency.Key)" asp-route-version="@null">@dependency.Key</a>
                                    <span class="bgt-dep-range">@dependency.Value</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (isMaven || isIvy || isPyPI || isRubyGems)
            {
                <div class="bgt-tab-body" x-show="tab === 'files'" x-cloak role="tabpanel">
                    <div class="bgt-table-wrap">
                        <table class="bgt-table">
                            <thead>
                                <tr>
                                    <th>File</th>
                                    <th>Size</th>
                                    <th>@(isMaven || isIvy ? "SHA-1" : "SHA-256")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in Model.Files)
                                {
                                    // Python and Ruby installers check files by SHA-256, Maven and Ivy clients by SHA-1.
                                    var fileUrl = isPyPI ? Url.PyPIFile(pypiName, version, file.FileName)
                                        : isRubyGems ? Url.RubyGemsGem(file.FileName)
                                        : isIvy ? $"{feedUrl}/ivy/{IvyPath.GetFilePath(Model.IvyManifest.Organisation, Model.IvyManifest.Module, Model.IvyManifest.ScalaVersion, Model.IvyManifest.SbtVersion, version, file.FileName)}"
                                        : $"{feedUrl}/maven2/{MavenFileUrlPath(groupId, artifactId, version, file.FileName)}";
                                    var hash = isMaven || isIvy ? file.Sha1 : file.Sha256;
                                    <tr>
                                        <td class="mono"><a href="@fileUrl">@file.FileName</a></td>
                                        <td>@file.Size.ToFileSize()</td>
                                        <td class="mono" title="@hash">@hash[..12]&hellip;</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @* The inner x-data is a separate Alpine component, so the tab condition stays on the outer element. *@
            <div x-show="tab === 'versions'" x-cloak role="tabpanel">
            <div class="bgt-tab-body" x-data="{ showAll: false, includePrerelease: true }">
                <div class="bgt-table-wrap">
                    <table class="bgt-table">
                        <thead>
                            <tr>
                                <th>Version</th>
                                <th>Downloads</th>
                                <th>Published</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Versions.Count; i++)
                            {
                                var row = Model.Versions[i];
                                var selected = row == current;
                                var alwaysShow = Json.Serialize(i < DefaultVisibleVersions);
                                var isPrerelease = Json.Serialize(row.IsPrerelease);
                                var percent = (int)Math.Round(row.Downloads * 100.0 / maxDownloads);

                                <tr class="@(selected ? "current" : null)" x-show="(includePrerelease || !@isPrerelease) && (showAll || !includePrerelease || @alwaysShow)">
                                    <td class="bgt-ver">
                                        <a asp-page="Artifact" asp-route-id="@Model.Id" asp-route-version="@row.Version" class="@(row.Listed ? null : "bgt-unlisted")">@row.Version</a>
                                        @if (selected)
                                        {
                                            <span class="bgt-badge bgt-badge-ok ms-2">current</span>
                                        }
                                        @if (!row.Listed)
                                        {
                                            <span class="bgt-badge ms-2">@unlistedLabel</span>
                                            @if (Model.CanManage)
                                            {
                                                <form method="post" asp-page-handler="Relist"
                                                      asp-route-id="@Model.Id"
                                                      asp-route-version="@row.Version"
                                                      class="d-inline ms-2">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-link-plain" style="font-size: 13px" title="@relistVerb this version">@relistVerb</button>
                                                </form>
                                            }
                                        }
                                        @if (!string.IsNullOrEmpty(row.CachedFrom))
                                        {
                                            <span class="bgt-badge ms-2" title="Downloaded from the mirror @row.CachedFrom">mirror</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="bgt-bar-cell">
                                            <div class="bgt-bar" aria-hidden="true"><div style="width: @(percent)%"></div></div>
                                            @row.Downloads.ToString("N0", CultureInfo.InvariantCulture)
                                        </div>
                                    </td>
                                    <td class="bgt-date">@Html.DisplayDate(row.Published)</td>
                                    <td class="text-end">
                                        @if (isPub || isNpm || isCargo || isGo || isHex || isComposer || isSwift || isCran || isVsix || isVsCode || (isCocoaPods && PodSourceUrl(row) != null))
                                        {
                                            <a href="@DownloadUrl(row.Version)" class="text-muted" style="font-size: 13px">Download</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (hasPrerelease || Model.Versions.Count > DefaultVisibleVersions)
                {
                    <div class="bgt-table-tools">
                        @if (hasPrerelease)
                        {
                            <label class="form-check form-switch">
                                <input type="checkbox" class="form-check-input" role="switch" x-model="includePrerelease" />
                                <span class="form-check-label" style="font-size: 13px">Include prerelease</span>
                            </label>
                        }
                        else
                        {
                            <span></span>
                        }
                        @if (Model.Versions.Count > DefaultVisibleVersions)
                        {
                            @* Hiding prereleases lifts the row cap, so the toggle is only needed with them shown. *@
                            <button type="button" class="btn-link-plain" style="font-size: 13px" x-show="includePrerelease" @@click="showAll = !showAll"
                                    x-text="showAll ? 'Show fewer versions' : 'Show all @Model.Versions.Count versions'">Show all versions</button>
                        }
                    </div>
                }
            </div>
            </div>
        </div>
    </div>

    <aside class="bgt-detail-aside">
        <div class="bgt-card bgt-stats3">
            <div>
                <div class="value">@Model.TotalDownloads.ToString("N0", CultureInfo.InvariantCulture)</div>
                <div class="label">Total</div>
            </div>
            <div>
                <div class="value">@current.Downloads.ToString("N0", CultureInfo.InvariantCulture)</div>
                <div class="label">This version</div>
            </div>
            <div>
                <div class="value">@Model.Versions.Count.ToString("N0", CultureInfo.InvariantCulture)</div>
                <div class="label">Versions</div>
            </div>
        </div>

        <div class="bgt-card bgt-side-card">
            <div class="bgt-card-label">About</div>
            <div class="bgt-kv">
                <div><span>Type</span><span>@FeedTypeNames.GetDisplayName(feed.Type)</span></div>
                <div><span>Updated</span><span>@Html.DisplayDate(Model.LastUpdated, Model.LastUpdated.Humanize(culture: CultureInfo.InvariantCulture))</span></div>
                <div><span>Size</span><span>@current.Size.ToFileSize()</span></div>
                @if (isMaven && !string.IsNullOrEmpty(Model.MavenPom.Packaging))
                {
                    <div><span>Packaging</span><span>@Model.MavenPom.Packaging</span></div>
                }
                @if (isIvy && !string.IsNullOrEmpty(Model.IvyManifest.Status))
                {
                    <div><span>Status</span><span>@Model.IvyManifest.Status</span></div>
                }
                @if (isComposer && !string.IsNullOrEmpty(Model.ComposerManifest.Type))
                {
                    <div><span>Package type</span><span>@Model.ComposerManifest.Type</span></div>
                }
                @if (isSwift && !string.IsNullOrEmpty(Model.SwiftManifest.Author))
                {
                    <div><span>Author</span><span>@Model.SwiftManifest.Author</span></div>
                }
                @if (isSwift && Model.SwiftManifest.IsSigned)
                {
                    <div><span>Signed</span><span>Yes</span></div>
                }
                @if (isCran && !string.IsNullOrEmpty(Model.CranManifest.Maintainer))
                {
                    <div><span>Maintainer</span><span>@Model.CranManifest.Maintainer</span></div>
                }
                @if (isCran && Model.CranManifest.NeedsCompilation)
                {
                    <div><span>Compiled code</span><span>Yes</span></div>
                }
                @if (isVsix)
                {
                    <div><span>Extension ID</span><span class="mono">@vsixId</span></div>
                }
                @if (isVsix && !string.IsNullOrEmpty(Model.VsixManifest.Publisher))
                {
                    <div><span>Publisher</span><span>@Model.VsixManifest.Publisher</span></div>
                }
                @if (isVsix && Model.VsixManifest.Preview)
                {
                    <div><span>Preview</span><span>Yes</span></div>
                }
                @if (isVsCode)
                {
                    <div><span>Extension ID</span><span class="mono">@vsCodeId</span></div>
                    <div><span>Platforms</span><span>@string.Join(", ", Model.VsCodeManifest.Files.Select(f => f.TargetPlatform))</span></div>
                }
                @if (isVsCode && vsCode?.IsPreRelease == true)
                {
                    <div><span>Pre-release</span><span>Yes</span></div>
                }
                @if (!string.IsNullOrEmpty(license))
                {
                    <div><span>License</span><span>@license</span></div>
                }
                @if (!string.IsNullOrEmpty(current.ContentHash))
                {
                    <div><span>SHA-256</span><span class="mono" title="@current.ContentHash">@current.ContentHash[..12]&hellip;</span></div>
                }
            </div>
            @if (links?.Count > 0)
            {
                <div class="bgt-side-links">
                    @foreach (var link in links)
                    {
                        <a href="@link.Value" rel="noopener noreferrer">@LinkLabel(link.Key) &#x2197;</a>
                    }
                </div>
            }
            @if (downloadUrl != null)
            {
                <a href="@downloadUrl" class="btn btn-secondary btn-block"><icon name="arrow-down" size="15" />Download @(isNpm || isHex || isCran ? "tarball" : isCargo ? "crate" : isGo || isComposer || isSwift ? "zip" : isCocoaPods ? "source" : isVsix || isVsCode ? "VSIX" : "archive")</a>
            }
        </div>

        @if (topics?.Count > 0)
        {
            <div class="bgt-card bgt-side-card">
                <div class="bgt-card-label">@(isNpm || isPyPI || isCargo || isComposer ? "Keywords" : "Topics")</div>
                <div class="bgt-chips">
                    @foreach (var topic in topics)
                    {
                        <span class="bgt-chip bgt-chip-lg">@topic</span>
                    }
                </div>
            </div>
        }

        @{ await Html.RenderPartialAsync("_PromoteCard", (Model.Id, (string)version)); }

        @if (Model.CanManage)
        {
            <div class="bgt-danger-zone">
                <div class="bgt-card-label mb-1">Manage</div>
                <p>@unlistGerund keeps the file, but clients no longer select this version for new installs. Deleting permanently removes this version and its files.</p>
                <div class="bgt-actions">
                    @if (current.Listed)
                    {
                        <form method="post" asp-page-handler="Unlist"
                              asp-route-id="@Model.Id"
                              asp-route-version="@version"
                              data-confirm="@($"{unlistVerb} {name} {version}? You can undo this later.")">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-secondary btn-sm">@unlistVerb @version</button>
                        </form>
                    }
                    <form method="post" asp-page-handler="Delete"
                          asp-route-id="@Model.Id"
                          asp-route-version="@version"
                          data-confirm="@($"Permanently delete {name} {version}? This removes the package and its files and cannot be undone.")">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete @version</button>
                    </form>
                </div>
            </div>
        }
    </aside>
</div>

@* Serialized as JSON, so characters such as the '+' of a version reach the script unchanged. *@
<script type="text/javascript">
    let installTabs = @Json.Serialize(installTabs);
</script>

@functions {

    private const int DefaultVisibleVersions = 5;

    // One tab of the install command card.
    private sealed class InstallTab
    {
        public string Name { get; init; }
        public string[] Content { get; init; }
    }

    private async Task TabButton(string key, string label, int? count)
    {
        <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: tab === '@key' }" x-bind:aria-selected="tab === '@key'" @@click="tab = '@key'">
            @label
            @if (count.HasValue)
            {
                <span class="bgt-tab-count">@count.Value.ToString(CultureInfo.InvariantCulture)</span>
            }
        </button>
    }

    private static string[] MavenDependency(string groupId, string artifactId, string version)
    {
        return
        [
            "<dependency>",
            $"  <groupId>{groupId}</groupId>",
            $"  <artifactId>{artifactId}</artifactId>",
            $"  <version>{version}</version>",
            "</dependency>",
        ];
    }

    // The Scala and sbt versions an sbt plugin is built for, or null for other modules.
    private static IReadOnlyList<KeyValuePair<string, string>> IvyEnvironment(IvyManifestSummary manifest)
    {
        if (manifest?.SbtVersion == null)
        {
            return null;
        }

        return manifest.ScalaVersion == null
            ? [KeyValuePair.Create("sbt", manifest.SbtVersion)]
            : [KeyValuePair.Create("sbt", manifest.SbtVersion), KeyValuePair.Create("Scala", manifest.ScalaVersion)];
    }

    // The Visual Studio versions an extension installs into, by the version ranges of its installation targets.
    private static IReadOnlyList<KeyValuePair<string, string>> VsixEnvironment(VsixManifest manifest)
    {
        return manifest?.InstallationTargets
            .Select(t => t.Version)
            .Where(v => !string.IsNullOrEmpty(v))
            .Distinct(StringComparer.Ordinal)
            .Select(v => KeyValuePair.Create("Visual Studio", v))
            .ToList();
    }

    // The VS Code versions a VS Code extension needs.
    private static IReadOnlyList<KeyValuePair<string, string>> VsCodeEnvironment(VsCodeManifest manifest)
    {
        return manifest?.GetProperty(VsCodeGalleryApi.EngineProperty) is { } engine ? [KeyValuePair.Create("VS Code", engine)] : null;
    }

    // The extensions a VS Code extension depends on, and those of its extension pack.
    private static IReadOnlyList<KeyValuePair<string, string>> VsCodeDependencies(VsCodeManifest manifest)
    {
        return manifest == null
            ? null
            : $"{manifest.GetProperty(VsCodeGalleryApi.ExtensionDependenciesProperty)},{manifest.GetProperty(VsCodeGalleryApi.ExtensionPackProperty)}"
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Select(id => KeyValuePair.Create(id, ""))
                .ToList();
    }

    // The source repository of a VS Code extension, when it is an http or https URL.
    private static IReadOnlyDictionary<string, string> VsCodeLinks(VsCodeManifest manifest)
    {
        return VsixManifest.GetLink(manifest?.GetProperty(VsCodeGalleryApi.SourceLinkProperty)) is { } link
            ? new Dictionary<string, string> { ["repository"] = link }
            : null;
    }

    // The links of an extension's manifest that are http or https URLs.
    private static IReadOnlyDictionary<string, string> VsixLinks(VsixManifest manifest)
    {
        if (manifest == null)
        {
            return null;
        }

        var links = new Dictionary<string, string>();
        foreach (var (key, value) in new[] { ("homepage", manifest.MoreInfo), ("documentation", manifest.GettingStartedGuide), ("release_notes", manifest.ReleaseNotes) })
        {
            if (VsixManifest.GetLink(value) is { } link)
            {
                links[key] = link;
            }
        }

        return links;
    }

    // The path of a file below the repository URL; the group id's dots are folders.
    private static string MavenFileUrlPath(string groupId, string artifactId, string version, string fileName)
    {
        return MavenPath.GetFilePath(groupId, artifactId, version, fileName);
    }

    private static string LinkLabel(string pubspecField)
    {
        return pubspecField switch
        {
            "homepage" => "Homepage",
            "repository" => "Source repository",
            "issue_tracker" or "bugs" => "Issue tracker",
            "documentation" => "Documentation",
            "license" => "License",
            "release_notes" => "Release notes",
            _ => pubspecField,
        };
    }
}

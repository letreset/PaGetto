@page
@model PaGetto.Web.Pages.ConnectModel
@using PaGetto.Core
@using PaGetto.Core.Configuration
@using PaGetto.Core.Feeds
@using Microsoft.Extensions.Options
@inject IUrlGenerator URL
@inject IOptionsSnapshot<NugetAuthenticationOptions> AuthOptions
@inject IFeedContext FeedContext

@{
    ViewData["Title"] = "Connect · " + FeedContext.CurrentFeed.Name;

    var serviceIndexUrl = URL.GetServiceIndexUrl();
    var feedSlug = FeedContext.CurrentFeed.Slug;

    var authMode = AuthOptions.Value.Mode;
    var hasEntra = authMode is AuthenticationMode.Entra or AuthenticationMode.Hybrid;
    var hasLocal = authMode is AuthenticationMode.Local or AuthenticationMode.Hybrid;
    var requiresAuth = authMode != AuthenticationMode.Legacy;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

@if (requiresAuth && !isAuthenticated)
{
    // Generic on purpose: anonymous visitors must not learn feed or package names.
    ViewData["Title"] = "Sign in required";
    <div class="bgt-message">
        <h2>Sign in required</h2>
        <p>You need to sign in to view connection instructions.</p>
        <a asp-page="/Login" class="btn btn-primary">Sign in</a>
    </div>
    return;
}

<div class="bgt-narrow bgt-stack">
    <div>
        <h1>Connect</h1>
        <p class="bgt-lead">Add this feed as a NuGet source using the service index below.</p>
    </div>

    <div class="bgt-card bgt-card-body" style="padding: 16px">
        <div class="form-label" style="margin-bottom: 8px">Service index · @FeedContext.CurrentFeed.Name</div>
        <div class="bgt-cmd bgt-cmd-value">
            <code id="feed-service-index-url">@serviceIndexUrl</code>
            <button type="button" class="bgt-cmd-btn" title="Copy feed URL" data-copy-target="#feed-service-index-url">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
    </div>

    @if (hasEntra || hasLocal)
    {
        <div class="bgt-callout">
            <icon name="lock" size="18" />
            <div>
                <div class="bgt-callout-title">Authentication required</div>
                <div class="bgt-callout-body">
                    @if (hasEntra && hasLocal)
                    {
                        <p>Entra (Microsoft) users: sign in to the web UI to generate a personal access token (PAT), then use it as the password / API key below.</p>
                        <p>Local accounts: use your username with a personal access token (PAT) from My Tokens, or your password. Accounts without web sign-in get their token from an administrator.</p>
                    }
                    else if (hasEntra)
                    {
                        <p>Sign in with your Microsoft account to generate a personal access token (PAT), then use it as the password / API key below.</p>
                    }
                    else
                    {
                        <p>Use your username with a personal access token (PAT) from My Tokens as the password / API key below. Your account password also works. Accounts without web sign-in get their token from an administrator.</p>
                    }
                </div>
                <a asp-page="/Account/Tokens" class="d-inline-block mt-2 fw-medium">Create a personal access token &rarr;</a>
            </div>
        </div>
    }

    <div class="bgt-card bgt-card-clip bgt-cmd-card" x-data="{ tabs: tabs, active: tabs[0] }">
        <div class="bgt-tabs bgt-tabs-sm" role="tablist" aria-label="Client">
            <template x-for="tab in tabs" :key="tab.name">
                <button type="button" class="bgt-tab" role="tab" x-bind:class="{ active: active.name === tab.name }"
                        x-bind:aria-selected="active.name === tab.name" x-text="tab.name" @@click="active = tab"></button>
            </template>
        </div>
        <div class="bgt-cmd">
            <code x-text="active.content.join('\n')"></code>
            <button type="button" class="bgt-cmd-btn" @@click="window.pagetto.copy(active.content.join('\n'), $el)">
                <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
            </button>
        </div>
        <div class="bgt-card-foot">
            For more information, see the
            <a target="_blank" rel="noopener noreferrer" x-bind:href="active.documentation" x-text="`${active.name} documentation ↗`"></a>
        </div>
    </div>
</div>

<script type="text/javascript">
    let tabs = [
        {
            name: ".NET CLI",
            content: ['dotnet nuget add source @serviceIndexUrl --name "@feedSlug" --username USERNAME --password API_KEY --store-password-in-clear-text'],
            documentation: "https://learn.microsoft.com/dotnet/core/tools/dotnet-nuget-add-source",
        },

        {
            name: "NuGet",
            content: ['nuget sources Add -Name "@feedSlug" -Source @serviceIndexUrl -Username USERNAME -Password API_KEY'],
            documentation: "https://learn.microsoft.com/nuget/reference/cli-reference/cli-ref-sources",
        },

        {
            name: "nuget.config",
            content: [
                '<?xml version="1.0" encoding="utf-8"?>',
                '<configuration>',
                '  <packageSources>',
                '    <add key="@feedSlug" value="@serviceIndexUrl" />',
                '  </packageSources>',
                '  <packageSourceCredentials>',
                '    <@feedSlug>',
                '      <add key="Username" value="USERNAME" />',
                '      <add key="ClearTextPassword" value="API_KEY" />',
                '    </@feedSlug>',
                '  </packageSourceCredentials>',
                '</configuration>',
            ],
            documentation: "https://learn.microsoft.com/nuget/reference/nuget-config-file",
        },

        {
            name: "Paket",
            content: ['source @serviceIndexUrl username: "USERNAME" password: "API_KEY"'],
            documentation: "https://fsprojects.github.io/Paket/nuget-dependencies.html",
        },
    ];
</script>

@page
@model LoginModel
@inject PaGetto.Web.Helper.ApplicationVersion Version

@{
    ViewData["Title"] = "Sign in";
    ViewData["Bare"] = true;

    var subtitle = Model.IsEntraEnabled && Model.IsLocalEnabled
        ? "Use your Microsoft or local account to continue."
        : Model.IsEntraEnabled ? "Use your Microsoft account to continue." : "Use your local account to continue.";
}

<div class="bgt-auth">
    <div class="bgt-auth-top">
        <a href="https://letreset.github.io/PaGetto/docs" target="_blank" rel="noopener noreferrer">Documentation</a>
        <button type="button" class="bgt-auth-theme" data-theme-toggle title="Switch to dark mode" aria-label="Switch to dark mode">
            <icon name="moon" class="bgt-theme-dark-icon" />
            <icon name="sun" class="bgt-theme-light-icon" />
        </button>
    </div>

    <main id="main" class="bgt-auth-center">
        <div class="bgt-auth-col">
            <div class="bgt-auth-brand">
                <img class="bgt-logo-light" src="~/_content/PaGetto.Web/images/pagetto-logo.svg" alt="PaGetto" />
                <img class="bgt-logo-dark" src="~/_content/PaGetto.Web/images/pagetto-logo-white.svg" alt="PaGetto" />
                <h1>Sign in to PaGetto</h1>
                <p>@subtitle</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mb-0" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            @if (Model.IsEntraEnabled || Model.IsLocalEnabled)
            {
                <div class="bgt-auth-card">
                    @if (Model.IsEntraEnabled)
                    {
                        <a href="@Url.Page("/Login", "EntraSignIn", new { ReturnUrl = Model.ReturnUrl })" class="btn btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 21" aria-hidden="true">
                                <rect x="1" y="1" width="9" height="9" fill="#f25022" />
                                <rect x="11" y="1" width="9" height="9" fill="#7fba00" />
                                <rect x="1" y="11" width="9" height="9" fill="#00a4ef" />
                                <rect x="11" y="11" width="9" height="9" fill="#ffb900" />
                            </svg>
                            Sign in with Microsoft
                        </a>

                        @if (Model.IsLocalEnabled)
                        {
                            <div class="bgt-auth-divider">or sign in with a local account</div>
                        }
                    }

                    @if (Model.IsLocalEnabled)
                    {
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div>
                                <label asp-for="Username" class="form-label"></label>
                                <input asp-for="Username" class="form-control form-control-lg" autocomplete="username" autofocus />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>

                            <div>
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary">Sign in</button>
                        </form>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning mb-0" role="alert">
                    Authentication is not configured. Contact your administrator.
                </div>
            }

            <p class="bgt-auth-version">PaGetto @Version.Version</p>
        </div>
    </main>
</div>

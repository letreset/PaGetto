@page
@using PaGetto.Core.Entities
@model PaGetto.Web.Pages.Admin.AccountsModel

@{
    ViewData["Title"] = "Accounts";

    // Keep the create form open when its last submission failed.
    var createFailed = !ViewData.ModelState.IsValid || (Model.NewUsername != null && Model.ErrorMessage != null);
}

@await Html.PartialAsync("_AdminTabs", "Accounts")

<div x-data="{ createOpen: @Json.Serialize(createFailed) }">
    <div class="bgt-page-head">
        <div>
            <h1>Accounts</h1>
            <p class="bgt-lead">@Model.Users.Count @(Model.Users.Count == 1 ? "account" : "accounts")</p>
        </div>
        <button type="button" class="btn btn-primary" @@click="createOpen = !createOpen" x-bind:aria-expanded="createOpen" aria-controls="create-account">
            <icon name="plus" size="15" />New account
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div id="create-account" class="bgt-card bgt-card-body mb-3" x-show="createOpen" @(createFailed ? null : "x-cloak")>
        <h2 class="bgt-card-title">Create local account</h2>
        <form method="post" asp-page-handler="Create">
            @Html.AntiForgeryToken()
            <div class="bgt-form-grid">
                <div>
                    <label asp-for="NewUsername" class="form-label">Username</label>
                    <input asp-for="NewUsername" class="form-control" autocomplete="off" />
                    <span asp-validation-for="NewUsername" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="NewDisplayName" class="form-label">Display name</label>
                    <input asp-for="NewDisplayName" class="form-control" autocomplete="off" />
                </div>
                <div>
                    <label asp-for="NewEmail" class="form-label">Email</label>
                    <input asp-for="NewEmail" type="email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="NewEmail" class="text-danger"></span>
                </div>
                <div>
                    <label asp-for="NewPassword" class="form-label">Password</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>
            </div>
            <div class="bgt-form-actions between">
                <label class="form-check form-switch">
                    <input asp-for="NewCanLoginToUI" class="form-check-input" role="switch" />
                    <span class="form-check-label">Can sign in to web UI</span>
                </label>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-secondary" @@click="createOpen = false">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create account</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="bgt-card">
    @if (Model.Users.Count == 0)
    {
        <div class="bgt-empty-row">No user accounts found.</div>
    }
    else
    {
        <div class="bgt-cols-head bgt-desktop-only" aria-hidden="true">
            <span style="flex: 1 1 260px">Account</span>
            <span style="flex: 1 1 200px">Groups</span>
            <span style="flex: 0 0 150px">Access</span>
            <span style="flex: 0 0 90px">Created</span>
            <span style="flex: 0 0 36px"></span>
        </div>

        @foreach (var user in Model.Users)
        {
            var isSelf = user.Id == Model.CurrentUserId;
            var isLocal = user.AuthProvider == AuthProvider.Local;
            var isLocked = PaGetto.Web.Pages.Admin.AccountsModel.IsLocked(user);
            var displayName = string.IsNullOrEmpty(user.DisplayName) ? user.Username : user.DisplayName;
            var subParts = new List<string>();
            if (!string.Equals(displayName, user.Username, StringComparison.Ordinal)) subParts.Add(displayName);
            subParts.Add(isLocal ? "Local" : "Entra");
            if (!string.IsNullOrEmpty(user.Email)) subParts.Add(user.Email);
            Model.UserGroupMemberships.TryGetValue(user.Id, out var groups);

            <div class="bgt-row bgt-acct-row @(user.IsEnabled ? null : "disabled")">
                <div class="bgt-acct-col-account">
                    <span class="bgt-avatar bgt-avatar-lg">@displayName.ToNameInitials()</span>
                    <div style="min-width: 0">
                        <div class="bgt-acct-name">
                            @user.Username
                            @if (user.IsAdmin)
                            {
                                <span class="bgt-badge bgt-badge-solid" title="@(isLocal ? "Administrator" : "Administrator through the Entra Admin app role")">Admin</span>
                            }
                            @if (isLocked)
                            {
                                <span class="bgt-badge bgt-badge-warn" title="Too many failed sign-ins">Locked until @user.LockedUntilUtc.Value.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC</span>
                            }
                        </div>
                        <div class="bgt-acct-sub" title="@string.Join(" · ", subParts)">@string.Join(" · ", subParts)</div>
                    </div>
                </div>
                <div class="bgt-acct-col-groups">
                    @if (groups != null && groups.Count > 0)
                    {
                        @foreach (var group in groups)
                        {
                            var isRoleSynced = !string.IsNullOrEmpty(group.AppRoleValue);
                            <span class="bgt-chip @(isRoleSynced ? null : "bgt-chip-muted")" title="@(isRoleSynced ? $"Role-synced via '{group.AppRoleValue}'" : "Manual membership")">@group.Name</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted" style="font-size: 13px">No groups</span>
                    }
                </div>
                <div class="bgt-acct-col-access">
                    @if (user.IsEnabled)
                    {
                        <span class="bgt-pill bgt-pill-ok bgt-pill-dot">Enabled</span>
                    }
                    else
                    {
                        <span class="bgt-pill bgt-pill-danger bgt-pill-dot">Disabled</span>
                    }
                    @if (user.CanLoginToUI)
                    {
                        <span class="bgt-pill bgt-pill-primary">Web + API</span>
                    }
                    else
                    {
                        <span class="bgt-pill">API only</span>
                    }
                </div>
                <span class="bgt-acct-col-created">@Html.DisplayDate(user.CreatedAtUtc)</span>
                <div class="bgt-acct-col-menu dropdown">
                    <button type="button" class="btn btn-secondary btn-icon" data-bs-toggle="dropdown" aria-expanded="false" title="Actions" aria-label="Actions for @user.Username">
                        <icon name="kebab" />
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end bgt-acct-menu">
                        @if (isLocal)
                        {
                            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#password-modal" data-user-id="@user.Id" data-username="@user.Username" data-initials="@displayName.ToNameInitials()">Reset password…</button></li>
                            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#token-modal" data-user-id="@user.Id" data-username="@user.Username" data-initials="@displayName.ToNameInitials()">New token…</button></li>
                        }
                        @* The signed-in administrator can't lock themselves out, so their own row has no Disable, web sign-in or admin toggle. *@
                        @if (!isSelf)
                        {
                            @if (isLocal)
                            {
                                <li><hr class="dropdown-divider" /></li>
                            }
                            <li>
                                <form method="post" asp-page-handler="ToggleCanLoginToUI">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="canLoginToUI" value="@user.CanLoginToUI.ToString()" />
                                    <button type="submit" class="dropdown-item">@(user.CanLoginToUI ? "Disable web sign-in" : "Allow web sign-in")</button>
                                </form>
                            </li>
                            @if (isLocal)
                            {
                                <li>
                                    <form method="post" asp-page-handler="ToggleAdmin">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="isAdmin" value="@user.IsAdmin.ToString()" />
                                        <button type="submit" class="dropdown-item">@(user.IsAdmin ? "Remove admin role" : "Make admin")</button>
                                    </form>
                                </li>
                            }
                            <li>
                                <form method="post" asp-page-handler="ToggleEnabled">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="isEnabled" value="@user.IsEnabled.ToString()" />
                                    <button type="submit" class="dropdown-item">@(user.IsEnabled ? "Disable account" : "Enable account")</button>
                                </form>
                            </li>
                        }
                        @if (isLocked)
                        {
                            <li>
                                <form method="post" asp-page-handler="Unlock">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="dropdown-item">Unlock</button>
                                </form>
                            </li>
                        }
                        @if (!user.IsEnabled)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li><button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#delete-modal" data-user-id="@user.Id" data-username="@user.Username" data-initials="@displayName.ToNameInitials()">Delete account…</button></li>
                        }
                    </ul>
                </div>
            </div>
        }
    }
</div>

@* One modal per action, filled with the account of the clicked menu item. *@
<div class="modal fade" id="password-modal" tabindex="-1" aria-labelledby="password-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" x-data="{ password: '' }">
            <div class="bgt-modal-head">
                <span class="bgt-avatar bgt-avatar-lg" data-fill="initials"></span>
                <div style="min-width: 0">
                    <h2 class="bgt-modal-title" id="password-modal-title">Reset password</h2>
                    <div class="bgt-modal-sub" data-fill="username"></div>
                </div>
                <button type="button" class="bgt-modal-close" data-bs-dismiss="modal" aria-label="Close"><icon name="x" /></button>
            </div>
            <form method="post" asp-page-handler="ResetPassword" class="bgt-modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" data-fill="userId" />
                <label for="reset-password" class="form-label">New password</label>
                <input type="password" id="reset-password" name="newPassword" class="form-control" minlength="12" autocomplete="new-password" required x-model="password" />
                <div class="form-text" x-bind:class="{ 'text-danger': password.length > 0 && password.length < 12 }"
                     x-text="password.length >= 12 ? 'Looks good.' : 'At least 12 characters · ' + password.length + '/12'">At least 12 characters</div>
                <div class="bgt-form-actions">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" x-bind:disabled="password.length < 12">Set password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="token-modal" tabindex="-1" aria-labelledby="token-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="bgt-modal-head">
                <span class="bgt-avatar bgt-avatar-lg" data-fill="initials"></span>
                <div style="min-width: 0">
                    <h2 class="bgt-modal-title" id="token-modal-title">New token</h2>
                    <div class="bgt-modal-sub" data-fill="username"></div>
                </div>
                <button type="button" class="bgt-modal-close" data-bs-dismiss="modal" aria-label="Close"><icon name="x" /></button>
            </div>
            <form method="post" asp-page-handler="CreateToken" class="bgt-modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" data-fill="userId" />
                <div class="bgt-token-form">
                    <div class="bgt-f-name" style="flex-basis: 200px">
                        <label for="token-name" class="form-label">Token name</label>
                        <input type="text" id="token-name" name="tokenName" class="form-control" placeholder="e.g. CI pipeline" maxlength="256" required />
                    </div>
                    <div class="bgt-f-expiry" style="flex-basis: 140px">
                        <label for="token-expiry" class="form-label">Expires in</label>
                        <select id="token-expiry" name="expiryDays" class="form-select">
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                            <option value="90" selected>90 days</option>
                            <option value="180">180 days</option>
                            <option value="365">1 year</option>
                        </select>
                    </div>
                </div>
                <div class="bgt-form-actions">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create token</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="delete-modal" tabindex="-1" aria-labelledby="delete-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="bgt-modal-head">
                <span class="bgt-avatar bgt-avatar-lg" data-fill="initials"></span>
                <div style="min-width: 0">
                    <h2 class="bgt-modal-title" id="delete-modal-title">Delete account</h2>
                    <div class="bgt-modal-sub" data-fill="username"></div>
                </div>
                <button type="button" class="bgt-modal-close" data-bs-dismiss="modal" aria-label="Close"><icon name="x" /></button>
            </div>
            <form method="post" asp-page-handler="Delete" class="bgt-modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" data-fill="userId" />
                <p>This permanently deletes <b data-fill="username"></b>, its tokens and group memberships. This can't be undone.</p>
                <div class="bgt-form-actions" style="margin-top: 18px">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete account</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.NewTokenPlaintext))
{
    <div class="modal fade" id="token-created-modal" tabindex="-1" aria-labelledby="token-created-title" aria-hidden="true" data-show-on-load>
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="bgt-modal-head">
                    <h2 class="bgt-modal-title" id="token-created-title">Token created</h2>
                    <button type="button" class="bgt-modal-close" data-bs-dismiss="modal" aria-label="Close"><icon name="x" /></button>
                </div>
                <div class="bgt-modal-body d-flex flex-column gap-3">
                    <div class="alert alert-success mb-0">@Model.SuccessMessage</div>
                    <div class="bgt-cmd bgt-cmd-value">
                        <code id="new-token-value">@Model.NewTokenPlaintext</code>
                        <button type="button" class="bgt-cmd-btn" data-copy-target="#new-token-value">
                            <icon name="copy" size="13" /><span class="bgt-copy-label">Copy</span>
                        </button>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(Model.SuccessMessage ?? Model.ToastMessage))
{
    <div class="bgt-toast" role="status"><icon name="check" />@(Model.SuccessMessage ?? Model.ToastMessage)</div>
}

@section Scripts {
    <script>
        (function () {
            // Fill a modal with the account of the menu item that opened it.
            document.querySelectorAll('#password-modal, #token-modal, #delete-modal').forEach(function (modal) {
                modal.addEventListener('show.bs.modal', function (event) {
                    var source = event.relatedTarget;
                    if (!source) return;
                    modal.querySelectorAll('[data-fill]').forEach(function (el) {
                        var key = el.getAttribute('data-fill');
                        var value = source.getAttribute('data-' + key.replace(/[A-Z]/g, function (c) { return '-' + c.toLowerCase(); })) || '';
                        if (el.tagName === 'INPUT') el.value = value; else el.textContent = value;
                    });
                    var form = modal.querySelector('form');
                    form.querySelectorAll('input[type=text], input[type=password]').forEach(function (input) {
                        input.value = '';
                        input.dispatchEvent(new Event('input'));
                    });
                });
                modal.addEventListener('shown.bs.modal', function () {
                    var first = modal.querySelector('input[type=text], input[type=password]');
                    if (first) first.focus();
                });
            });

            var created = document.querySelector('[data-show-on-load]');
            if (created) bootstrap.Modal.getOrCreateInstance(created).show();
        })();
    </script>
}
